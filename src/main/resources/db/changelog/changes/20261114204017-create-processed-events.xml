<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="20261114204017-create-processed-events" author="sena">

        <createTable tableName="processed_events">

            <column name="event_id" type="CHAR(36)">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_processed_events"
                        nullable="false"/>
            </column>

            <column name="processed_at" type="DATETIME(6)"
                    defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <rollback>
            <dropTable tableName="processed_events"/>
        </rollback>

    </changeSet>

</databaseChangeLog>